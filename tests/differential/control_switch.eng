Set level to 2.
Switch level:
    When 1:
        Say "low".
        Break.
    When 2:
        Say "medium".
        Break.
    Otherwise:
        Say "high".
        Break.
End switch.
Set code to 9.
Switch code:
    When 2:
        Say "second".
        Break.
    Otherwise:
        Say "other".
        Break.
End switch.
