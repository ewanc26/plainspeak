Declare lock as long integer with value Call ps_mutex_create done.
Declare total as integer with value 0.
Procedure worker takes arg as pointer to void returns integer:
    Declare i as integer with value 0.
    Declare status as integer with value 0.
    While i is less than 1000:
        Set status to Call ps_mutex_lock with lock done.
        Set total to total plus 1.
        Set status to Call ps_mutex_unlock with lock done.
        Increase i by 1.
    End while.
    Return 0.
End procedure.
